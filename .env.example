# ContractIQ — Environment Variables Reference
# Copy to .env and fill in values. NEVER commit .env to source control.
# Local dev uses emulators; production uses Azure managed identities / Key Vault.

# ─── Identity ────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=contractiq
KEYCLOAK_CLIENT_ID=contractiq-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ─── Databases ───────────────────────────────────────────────────────────────
SQLSERVER_CONNECTION_STRING=Server=sqlserver,1433;Database=ContractIQ;User Id=sa;Password=ContractIQ_Dev!2024;TrustServerCertificate=True
REDIS_CONNECTION_STRING=redis:6379

# ─── Blob Storage ────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OTiEunht68sI7FIJUXY8SzONgN==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# ─── Vector Search ───────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Message Bus ─────────────────────────────────────────────────────────────
RABBITMQ_CONNECTION_STRING=amqp://contractiq:contractiq@rabbitmq:5672/contractiq
# Production: AZURE_SERVICEBUS_CONNECTION_STRING=<from Key Vault>

# ─── LLM Provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=fake                    # fake | ollama | azure-openai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Production:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<from Key Vault>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── LangSmith ───────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=                   # optional; evals still run locally if absent
LANGSMITH_PROJECT=contractiq-dev
LANGCHAIN_TRACING_V2=true

# ─── Telemetry ───────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=contractiq
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ─── Service URLs (internal, Docker network) ─────────────────────────────────
CONTRACTS_API_URL=http://contracts-api:8080
WORKFLOW_API_URL=http://workflow-api:8080
AUDIT_API_URL=http://audit-api:8080
INTEGRATIONS_API_URL=http://integrations-api:8080
TENANTS_API_URL=http://tenants-api:8080
AGENT_SERVICE_URL=http://agent-service:8000
MCP_SERVER_URL=http://mcp-server:8001

# ─── SAP Mock ────────────────────────────────────────────────────────────────
SAP_BASE_URL=http://sap-mock:4004/sap/opu/odata/sap
SAP_CLIENT_ID=dev-client
SAP_CLIENT_SECRET=dev-secret
SAP_FAULT_INJECTION=false           # set true to test circuit breaker

# ─── Salesforce Mock ─────────────────────────────────────────────────────────
SALESFORCE_BASE_URL=http://salesforce-mock:8080
SALESFORCE_CLIENT_ID=dev-client
SALESFORCE_CLIENT_SECRET=dev-secret
SALESFORCE_INSTANCE_URL=http://salesforce-mock:8080

# ─── Security ────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-in-production
FILE_ENCRYPTION_KEY=                # AES-256 key for encrypted temp files; auto-generated if empty

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_INJECTION_CLASSIFIER=true
ENABLE_PII_REDACTION=true
ENABLE_COST_TRACKING=true
MAX_FILE_SIZE_MB=50
TOKEN_BUDGET_PER_RUN=100000
