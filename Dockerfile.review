FROM node:22-alpine AS frontend
WORKDIR /web
COPY src/frontend/package*.json ./
RUN npm ci
COPY src/frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements-review.txt ./
RUN pip install --no-cache-dir -r requirements-review.txt
COPY src/agent/app/review/ ./app/review/
COPY --from=frontend /web/dist ./web/
RUN useradd --create-home appuser && mkdir -p /data && chown appuser:appuser /data
USER appuser
ENV REVIEW_FRONTEND_DIST=/app/web REVIEW_DB=/data/reviews.sqlite3
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.review.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
