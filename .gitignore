# .gitignore for ContractIQ v2

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
*.user

# Build outputs & dependencies - Node.js / React
**/node_modules/
**/dist/
**/build/
.output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs & dependencies - .NET
**/bin/
**/obj/
*.user
*.userosscache
*.sln.docstates

# Build outputs & dependencies - Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/

# Environment secrets
.env
*.env.local

# Docker volumes / persistence data
**/data/
**/sqlserver-data/
**/rabbitmq-data/
**/qdrant-data/
**/azurite-data/
