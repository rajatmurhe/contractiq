# Set these on the server. Never add secrets to frontend VITE_ variables.
GOOGLE_CLIENT_ID=
REVIEW_LLM_API_KEY=
REVIEW_LLM_BASE_URL=https://api.openai.com/v1
REVIEW_LLM_MODEL=gpt-4o-mini
# OpenRouter alternative: use all three settings together, with an OpenRouter key.
# REVIEW_LLM_API_KEY=<your OpenRouter key, configured privately>
# REVIEW_LLM_BASE_URL=https://openrouter.ai/api/v1
# REVIEW_LLM_MODEL=openai/gpt-4o-mini
REVIEW_DB=data/reviews.sqlite3
REVIEW_HOURLY_MODEL_LIMIT=60

# Optional cost estimates. Enter current provider prices, USD per million tokens.
# Leave blank to report unknown cost; never assume zero.
REVIEW_INPUT_PRICE_PER_MILLION=
REVIEW_OUTPUT_PRICE_PER_MILLION=

# Groq free-plan candidate; verify access and quality before submission.
# REVIEW_LLM_API_KEY=<your Groq key, configured privately>
# REVIEW_LLM_BASE_URL=https://api.groq.com/openai/v1
# REVIEW_LLM_MODEL=openai/gpt-oss-120b
# REVIEW_JSON_SCHEMA=0

# Optional for reasoning models; tested locally with Groq GPT-OSS 120B.
# REVIEW_REASONING_EFFORT=low

# Long documents are reviewed in sections; free providers may need a minute between calls.
REVIEW_SECTION_CHARS=9000
REVIEW_MAX_OUTPUT_TOKENS=3000
REVIEW_SECTION_PAUSE=60
